// @ShaderName "Simple Albedo"
// @ShadingModel SimpleAlbedo
// @VertShader deferred_geometry

// ─────────────────────────────────────────────────────────────────────────────
// GBuffer Pass — fragment shader for the deferred G-buffer pass.
//
// Writes albedo + geometric normal into the G-buffer MRT.
// Supports a single base color tint and an optional albedo texture.
// ─────────────────────────────────────────────────────────────────────────────
#pragma sa_section gbuffer

#version 450
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_nonuniform_qualifier : enable
#include "common.glsl"
#include "shading_models.glsl"
#include "shading_model_ids.glsl"
#include "bindless_textures.glsl"

// ── Material parameters (set = 2, binding = 0, SSBO + bindless, #73-A) ───────
layout(std430, set = 2, binding = 0) readonly buffer MaterialParams {
    vec4 baseColorFactor; // @Color4("Base Color") = 1,1,1,1
    uint t_BaseColor_Idx; // @Texture("Albedo Map")
} u_Mat;

// Shared with deferred_geometry.vert — only normal and UV are used.
layout(location = 1) in vec3 v_Normal;
layout(location = 3) in vec2 v_TexCoord0;

// G-Buffer outputs
//   RT0: albedo.rgb + occlusion.a
//   RT1: oct-normal(RG) + roughness(B) + metallic(A)
//   RT2: data.rgb + shading_model_id.a
layout(location = 0) out vec4 out_GAlbedoOcclusion;
layout(location = 1) out vec4 out_GNormalRoughness;
layout(location = 2) out vec4 out_GData;

void main() {
    vec4 color = SampleBindless(u_Mat.t_BaseColor_Idx, v_TexCoord0) * u_Mat.baseColorFactor;
    vec3 N     = normalize(v_Normal);

    out_GAlbedoOcclusion = vec4(color.rgb, 1.0);
    out_GNormalRoughness  = vec4(OctEncode(N), 1.0, 0.0);
    out_GData             = vec4(0.0, 0.0, 0.0, EncodeShadingFlags(SHADING_MODEL_SIMPLE_ALBEDO));
}

#pragma sa_end_section

// ─────────────────────────────────────────────────────────────────────────────
// Lighting Pass — evaluated by the deferred lighting pass per-pixel.
//
// Must implement exactly: vec3 EvaluateShading(GBufferData gbuf)
// The dispatcher renames it to avoid symbol collisions with other models.
// ─────────────────────────────────────────────────────────────────────────────
#pragma sa_section lighting

vec3 EvaluateShading(GBufferData gbuf) {
    return gbuf.albedo;
}

#pragma sa_end_section
