#version 450

// ibl_prefilter.comp
// Prefilters a mipmapped HDR cubemap for specular IBL via GGX importance sampling.
// Uses PDF-based LOD selection on the input cubemap to eliminate fireflies.
// Outputs a cubemap (6-face image2DArray) — one mip level at a time.
//
// Bindings:
//   set=0, binding=0 : rgba32f image2DArray  (output cubemap — one mip, 6 faces)
//   set=0, binding=1 : samplerCube           (input HDR cubemap with full mip chain)
//
// Push constants:
//   roughness   — in [0..1], mip 0=0.0 … mip 4=1.0
//   envFaceSize — pixel width/height of mip 0 in the input cubemap (e.g. 512.0)
//
// Dispatch: ceil(faceSize/8), ceil(faceSize/8), 6
//   gl_GlobalInvocationID.z = face index [0..5]

layout(set = 0, binding = 0, rgba32f) uniform writeonly image2DArray u_Output;
layout(set = 0, binding = 1) uniform samplerCube u_HdrCube;

layout(push_constant) uniform PC {
    float roughness;
    float envFaceSize;
} pc;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

const float PI        = 3.14159265359;
const uint  N_SAMPLES = 1024u;

float RadicalInverse(uint bits) {
    bits = (bits << 16u) | (bits >> 16u);
    bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
    bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
    bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
    bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
    return float(bits) * 2.3283064365386963e-10;
}

vec2 Hammersley(uint i, uint N) {
    return vec2(float(i) / float(N), RadicalInverse(i));
}

// GGX normal distribution function
float DistributionGGX(float NdotH, float roughness) {
    float a  = roughness * roughness;
    float a2 = a * a;
    float d  = NdotH * NdotH * (a2 - 1.0) + 1.0;
    return a2 / (PI * d * d);
}

// GGX importance sample — result in world space around N
vec3 ImportanceSampleGGX(vec2 Xi, vec3 N, float roughness) {
    float a         = roughness * roughness;
    float phi       = 2.0 * PI * Xi.x;
    float cosTheta  = sqrt((1.0 - Xi.y) / (1.0 + (a * a - 1.0) * Xi.y + 1e-6));
    float sinTheta  = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));
    vec3  H         = vec3(sinTheta * cos(phi), sinTheta * sin(phi), cosTheta);
    vec3  up        = abs(N.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3  T         = normalize(cross(up, N));
    vec3  B         = cross(N, T);
    return normalize(T * H.x + B * H.y + N * H.z);
}

// Cubemap face + pixel UV [0,1] → world-space direction (Vulkan/OpenGL convention)
vec3 CubeFaceDir(uint face, vec2 uv) {
    float s = uv.x * 2.0 - 1.0;
    float t = uv.y * 2.0 - 1.0;
    if      (face == 0u) return normalize(vec3( 1.0,  -t,  -s)); // +X
    else if (face == 1u) return normalize(vec3(-1.0,  -t,   s)); // -X
    else if (face == 2u) return normalize(vec3(   s, 1.0,   t)); // +Y
    else if (face == 3u) return normalize(vec3(   s, -1.0, -t)); // -Y
    else if (face == 4u) return normalize(vec3(   s,  -t, 1.0)); // +Z
    else                 return normalize(vec3(  -s,  -t, -1.0)); // -Z
}

void main() {
    ivec3 size  = imageSize(u_Output);            // (faceSize, faceSize, 6)
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    uint  face  = gl_GlobalInvocationID.z;
    if (coord.x >= size.x || coord.y >= size.y) return;

    vec2 uv = (vec2(coord) + 0.5) / vec2(size.xy);

    // Reflection/view direction for this cubemap texel (V = N = R assumed)
    vec3 R = CubeFaceDir(face, uv);
    vec3 N = R;

    // Solid angle covered by one texel in the input cubemap at mip 0
    float saTexel = 4.0 * PI / (6.0 * pc.envFaceSize * pc.envFaceSize);

    vec3  prefilteredColor = vec3(0.0);
    float totalWeight      = 0.0;

    for (uint i = 0u; i < N_SAMPLES; ++i) {
        vec2  Xi    = Hammersley(i, N_SAMPLES);
        vec3  H     = ImportanceSampleGGX(Xi, N, pc.roughness);
        vec3  L     = normalize(2.0 * dot(R, H) * H - R);
        float NdotL = max(dot(N, L), 0.0);
        float NdotH = max(dot(N, H), 0.0);
        float HdotV = max(dot(H, R), 0.0);

        if (NdotL > 0.0) {
            // GGX PDF: p(H) = D * NdotH; Jacobian from H to L: 1/(4*HdotV)
            float D        = DistributionGGX(NdotH, pc.roughness);
            float pdf      = max(D * NdotH / (4.0 * HdotV + 1e-6), 1e-6);

            // Solid angle of this sample — select mip so we read a pre-blurred
            // texel rather than a single bright spike (eliminates fireflies)
            float saSample = 1.0 / (float(N_SAMPLES) * pdf + 0.0001);
            float mipLevel = pc.roughness == 0.0 ? 0.0 : max(0.0, 0.5 * log2(saSample / saTexel));

            prefilteredColor += textureLod(u_HdrCube, L, mipLevel).rgb * NdotL;
            totalWeight      += NdotL;
        }
    }

    vec3 result = (totalWeight > 0.0)
                ? prefilteredColor / totalWeight
                : vec3(0.0);

    imageStore(u_Output, ivec3(coord, face), vec4(result, 1.0));
}
