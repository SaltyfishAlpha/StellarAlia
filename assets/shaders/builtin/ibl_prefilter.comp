#version 450

// ibl_prefilter.comp
// Prefilters an HDR equirect panorama for specular IBL via GGX importance sampling.
// Dispatched once per mip level; roughness is passed via push constant.
//
// Bindings:
//   set=0, binding=0 : rgba32f storage image  (output — one mip at a time)
//   set=0, binding=1 : sampler2D              (input equirect HDR, always mip 0)
//
// Push constants:
//   roughness — in [0..1], corresponds to mip 0=0.0 … mip 4=1.0

layout(set = 0, binding = 0, rgba32f) uniform writeonly image2D u_Output;
layout(set = 0, binding = 1) uniform sampler2D u_HdrMap;

layout(push_constant) uniform PC {
    float roughness;
} pc;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

const float PI        = 3.14159265359;
const uint  N_SAMPLES = 512u;

float RadicalInverse(uint bits) {
    bits = (bits << 16u) | (bits >> 16u);
    bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
    bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
    bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
    bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
    return float(bits) * 2.3283064365386963e-10;
}

vec2 Hammersley(uint i, uint N) {
    return vec2(float(i) / float(N), RadicalInverse(i));
}

// GGX importance sample — result in world space around N
vec3 ImportanceSampleGGX(vec2 Xi, vec3 N, float roughness) {
    float a         = roughness * roughness;
    float phi       = 2.0 * PI * Xi.x;
    float cosTheta  = sqrt((1.0 - Xi.y) / (1.0 + (a * a - 1.0) * Xi.y + 1e-6));
    float sinTheta  = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));
    vec3  H         = vec3(sinTheta * cos(phi), sinTheta * sin(phi), cosTheta);
    vec3  up        = abs(N.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3  T         = normalize(cross(up, N));
    vec3  B         = cross(N, T);
    return normalize(T * H.x + B * H.y + N * H.z);
}

vec3 EquirectToDir(float u, float v) {
    float phi   = (u * 2.0 - 1.0) * PI;
    float theta = (0.5 - v) * PI;
    float ct    = cos(theta);
    return vec3(ct * cos(phi), sin(theta), ct * sin(phi));
}

vec2 DirToEquirect(vec3 d) {
    float phi   = atan(d.z, d.x);
    float theta = asin(clamp(d.y, -1.0, 1.0));
    return vec2(phi / (2.0 * PI) + 0.5, 0.5 - theta / PI);
}

void main() {
    ivec2 size  = imageSize(u_Output);
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= size.x || coord.y >= size.y) return;

    float u = (float(coord.x) + 0.5) / float(size.x);
    float v = (float(coord.y) + 0.5) / float(size.y);

    // Reflection/view direction for this texel (simplified: V = N = R)
    vec3 R = EquirectToDir(u, v);
    vec3 N = R;

    vec3  prefilteredColor = vec3(0.0);
    float totalWeight      = 0.0;

    for (uint i = 0u; i < N_SAMPLES; ++i) {
        vec2  Xi    = Hammersley(i, N_SAMPLES);
        vec3  H     = ImportanceSampleGGX(Xi, N, pc.roughness);
        vec3  L     = normalize(2.0 * dot(R, H) * H - R);
        float NdotL = max(dot(N, L), 0.0);

        if (NdotL > 0.0) {
            vec3 envSample = textureLod(u_HdrMap, DirToEquirect(L), 0.0).rgb;

            // Firefly suppression: clamp per-sample luminance.
            // Without HDR mip chain we can't do PDF-based mip selection, so we
            // hard-clamp very bright samples that would otherwise become hot spots.
            float lum = dot(envSample, vec3(0.2126, 0.7152, 0.0722));
            const float kFireflyThreshold = 100.0;
            if (lum > kFireflyThreshold) envSample *= kFireflyThreshold / lum;

            prefilteredColor += envSample * NdotL;
            totalWeight      += NdotL;
        }
    }

    vec3 result = (totalWeight > 0.0)
                ? prefilteredColor / totalWeight
                : vec3(0.0);

    imageStore(u_Output, coord, vec4(result, 1.0));
}
