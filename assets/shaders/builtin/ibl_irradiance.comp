#version 450

// ibl_irradiance.comp
// Integrates diffuse irradiance from an HDR equirectangular panorama.
// For each output texel N (a direction on the hemisphere), accumulates
// L(ω)·cos(θ) dω via Riemann sum over the hemisphere.
//
// Bindings:
//   set=0, binding=0 : rgba32f storage image  (output 256×128)
//   set=0, binding=1 : sampler2D              (input equirect HDR)

layout(set = 0, binding = 0, rgba32f) uniform writeonly image2D u_Output;
layout(set = 0, binding = 1) uniform sampler2D u_HdrMap;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

const float PI      = 3.14159265359;
const uint  N_PHI   = 128u;
const uint  N_THETA = 64u;

// Equirectangular UV (same convention as frame_uniforms DirToEquirect / EquirectToDir)
vec3 EquirectToDir(float u, float v) {
    float phi   = (u * 2.0 - 1.0) * PI;
    float theta = (0.5 - v) * PI;
    float ct    = cos(theta);
    return vec3(ct * cos(phi), sin(theta), ct * sin(phi));
}

vec2 DirToEquirect(vec3 d) {
    float phi   = atan(d.z, d.x);
    float theta = asin(clamp(d.y, -1.0, 1.0));
    return vec2(phi / (2.0 * PI) + 0.5, 0.5 - theta / PI);
}

void main() {
    ivec2 size  = imageSize(u_Output);
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= size.x || coord.y >= size.y) return;

    float u = (float(coord.x) + 0.5) / float(size.x);
    float v = (float(coord.y) + 0.5) / float(size.y);

    // Surface normal direction for this output texel
    vec3 N  = EquirectToDir(u, v);
    vec3 up = abs(N.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 T  = normalize(cross(up, N));
    vec3 B  = cross(N, T);

    float dPhi   = 2.0 * PI / float(N_PHI);
    float dTheta = 0.5  * PI / float(N_THETA);

    vec3  irr  = vec3(0.0);
    float wSum = 0.0;

    for (uint ti = 0u; ti < N_THETA; ++ti) {
        float theta = (float(ti) + 0.5) * dTheta;
        float sinT  = sin(theta);
        float cosT  = cos(theta);
        float w     = cosT * sinT;  // NdotL × Jacobian

        for (uint pi = 0u; pi < N_PHI; ++pi) {
            float phi   = (float(pi) + 0.5) * dPhi;
            vec3  s     = vec3(sinT * cos(phi), sinT * sin(phi), cosT);
            vec3  sWorld = s.x * T + s.y * B + s.z * N;
            irr  += textureLod(u_HdrMap, DirToEquirect(sWorld), 0.0).rgb * w;
            wSum += w;
        }
    }

    irr = (wSum > 0.0) ? irr * (PI / wSum) : vec3(0.0);
    imageStore(u_Output, coord, vec4(irr, 1.0));
}
