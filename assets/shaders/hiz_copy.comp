#version 450

// Hi-Z pyramid seed (Issue #89): copy scene depth (D32F) into mip0 of the R32F Hi-Z
// chain, so hiz_spd.comp can min-reduce it into mip1..N. Raw NDC depth is kept (near=0),
// matching the SSR traversal's depth-space cell test — no linearisation here.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0)               uniform sampler2D t_depth;      // D32F scene depth
layout(set = 0, binding = 1, r32f) uniform writeonly image2D u_hizMip0;    // Hi-Z mip0

layout(push_constant) uniform PC { ivec2 size; } pc;

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= pc.size.x || px.y >= pc.size.y) return;
    imageStore(u_hizMip0, px, vec4(texelFetch(t_depth, px, 0).r));
}
