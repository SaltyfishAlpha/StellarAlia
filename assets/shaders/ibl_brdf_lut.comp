#version 450

// ibl_brdf_lut.comp
// Computes the split-sum BRDF LUT (Smith-GGX).
// Output: set=0, binding=0 = rgba32f storage image
//   X axis (u) → NdotV [0..1]
//   Y axis (v) → roughness [0..1]
//   RG = (scale, bias) for Schlick Fresnel approximation

layout(set = 0, binding = 0, rgba32f) uniform writeonly image2D u_Output;
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

const float PI        = 3.14159265359;
const uint  N_SAMPLES = 1024u;

float RadicalInverse(uint bits) {
    bits = (bits << 16u) | (bits >> 16u);
    bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
    bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
    bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
    bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
    return float(bits) * 2.3283064365386963e-10;
}

vec2 Hammersley(uint i, uint N) {
    return vec2(float(i) / float(N), RadicalInverse(i));
}

// GGX importance sample — result in tangent space around N = (0,0,1)
vec3 ImportanceSampleGGX(vec2 Xi, float roughness) {
    float a         = roughness * roughness;
    float phi       = 2.0 * PI * Xi.x;
    float cosTheta  = sqrt((1.0 - Xi.y) / (1.0 + (a * a - 1.0) * Xi.y + 1e-6));
    float sinTheta  = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));
    return vec3(sinTheta * cos(phi), sinTheta * sin(phi), cosTheta);
}

// Schlick-GGX geometry term (IBL variant: k = roughness²/2)
float GeomSchlickGGX(float NdotV, float roughness) {
    float k = (roughness * roughness) * 0.5;
    return NdotV / (NdotV * (1.0 - k) + k + 1e-7);
}

void main() {
    ivec2 size  = imageSize(u_Output);
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= size.x || coord.y >= size.y) return;

    // NdotV maps to X (pixel center sampling)
    float NdotV     = (float(coord.x) + 0.5) / float(size.x);
    float roughness = (float(coord.y) + 0.5) / float(size.y);

    // View vector in tangent space: N = (0,0,1)
    vec3 V = vec3(sqrt(1.0 - NdotV * NdotV), 0.0, NdotV);
    vec3 N = vec3(0.0, 0.0, 1.0);

    float A = 0.0;
    float B = 0.0;

    for (uint i = 0u; i < N_SAMPLES; ++i) {
        vec2 Xi  = Hammersley(i, N_SAMPLES);
        vec3 H   = ImportanceSampleGGX(Xi, roughness);
        vec3 L   = normalize(2.0 * dot(V, H) * H - V);

        float NdotL = max(L.z,            0.0);
        float NdotH = max(H.z,            0.0);
        float VdotH = max(dot(V, H),      0.0);

        if (NdotL > 0.0) {
            float G     = GeomSchlickGGX(NdotV, roughness)
                        * GeomSchlickGGX(NdotL, roughness);
            float G_Vis = G * VdotH / (NdotH * NdotV + 1e-7);
            float Fc    = pow(1.0 - VdotH, 5.0);
            A += (1.0 - Fc) * G_Vis;
            B += Fc          * G_Vis;
        }
    }

    imageStore(u_Output, coord,
               vec4(A / float(N_SAMPLES), B / float(N_SAMPLES), 0.0, 1.0));
}
