#version 450

// Compute port of bloom_downsample.frag (Issue #92) — 13-tap Jimenez downsample,
// one thread per output (mip[i+1]) texel. Pure write (no blend).

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 2, binding = 0)          uniform sampler2D        t_Input;
layout(set = 2, binding = 1, rgba16f) uniform writeonly image2D out_mip;

vec3 S(vec2 uv) {
    vec2 ht = 0.5 / vec2(textureSize(t_Input, 0));
    return texture(t_Input, clamp(uv, ht, 1.0 - ht)).rgb;
}

void main() {
    ivec2 gid     = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outSize = imageSize(out_mip);
    if (gid.x >= outSize.x || gid.y >= outSize.y) return;

    vec2 v_UV = (vec2(gid) + 0.5) / vec2(outSize);
    vec2 ts   = 1.0 / vec2(textureSize(t_Input, 0));

    vec3 a = S(v_UV + ts * vec2(-2,-2));
    vec3 b = S(v_UV + ts * vec2( 0,-2));
    vec3 c = S(v_UV + ts * vec2( 2,-2));
    vec3 d = S(v_UV + ts * vec2(-1,-1));
    vec3 e = S(v_UV + ts * vec2( 1,-1));
    vec3 f = S(v_UV + ts * vec2(-2, 0));
    vec3 g = S(v_UV + ts * vec2( 0, 0));
    vec3 hh= S(v_UV + ts * vec2( 2, 0));
    vec3 i = S(v_UV + ts * vec2(-1, 1));
    vec3 j = S(v_UV + ts * vec2( 1, 1));
    vec3 k = S(v_UV + ts * vec2(-2, 2));
    vec3 l = S(v_UV + ts * vec2( 0, 2));
    vec3 m = S(v_UV + ts * vec2( 2, 2));

    vec3 color =
        (d + e + i + j) * 0.125    +
        (b + f + hh+ l) * 0.0625   +
        (a + c + k + m) * 0.03125  +
        g               * 0.125;

    imageStore(out_mip, gid, vec4(color, 1.0));
}
