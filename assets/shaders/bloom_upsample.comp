#version 450

// Compute port of bloom_upsample.frag (Issue #92) — 3×3 tent upsample.
// The frag version relied on hardware Additive blend; compute has none, so we
// read-modify-write the destination (finer mip): out = load(out) + tent.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 2, binding = 0)          uniform sampler2D t_Input;   // coarser mip
layout(set = 2, binding = 1, rgba16f) uniform image2D  io_mip;     // finer mip (readwrite)

layout(push_constant) uniform PushConstants {
    float radius;
    float _p0, _p1, _p2;
} pc;

vec3 S(vec2 uv) {
    vec2 ht = 0.5 / vec2(textureSize(t_Input, 0));
    return texture(t_Input, clamp(uv, ht, 1.0 - ht)).rgb;
}

void main() {
    ivec2 gid     = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outSize = imageSize(io_mip);
    if (gid.x >= outSize.x || gid.y >= outSize.y) return;

    vec2 v_UV = (vec2(gid) + 0.5) / vec2(outSize);
    vec2 ts   = pc.radius / vec2(textureSize(t_Input, 0));

    // 3×3 tent: corners=1, edges=2, center=4 (sum=16)
    vec3 result =
        S(v_UV + ts * vec2(-1.0, -1.0)) * 1.0 +
        S(v_UV + ts * vec2( 0.0, -1.0)) * 2.0 +
        S(v_UV + ts * vec2( 1.0, -1.0)) * 1.0 +
        S(v_UV + ts * vec2(-1.0,  0.0)) * 2.0 +
        S(v_UV                        ) * 4.0 +
        S(v_UV + ts * vec2( 1.0,  0.0)) * 2.0 +
        S(v_UV + ts * vec2(-1.0,  1.0)) * 1.0 +
        S(v_UV + ts * vec2( 0.0,  1.0)) * 2.0 +
        S(v_UV + ts * vec2( 1.0,  1.0)) * 1.0;
    result /= 16.0;

    vec3 dst = imageLoad(io_mip, gid).rgb;             // additive accumulation
    imageStore(io_mip, gid, vec4(dst + result, 1.0));
}
