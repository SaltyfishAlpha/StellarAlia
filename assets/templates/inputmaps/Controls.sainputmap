{
  "name": "Gameplay",
  "passthrough": true,
  "actions": [
    {
      "name": "Move",
      "type": "Axis2D",
      "userConfigurable": false,
      "bindings": [
        { "kind": "WASD", "up": "Keyboard/W", "down": "Keyboard/S", "left": "Keyboard/A", "right": "Keyboard/D", "normalize": true },
        { "kind": "Direct", "path": "Gamepad/LeftStick", "deadZone": 0.12 }
      ]
    },
    {
      "name": "Look",
      "type": "Axis2D",
      "userConfigurable": false,
      "bindings": [
        { "kind": "Direct", "path": "Mouse/Delta", "scale": 0.08 },
        { "kind": "Direct", "path": "Gamepad/RightStick", "deadZone": 0.12, "scale": [2.0, -2.0] }
      ]
    },
    {
      "name": "Jump",
      "type": "Button",
      "userConfigurable": false,
      "activationThreshold": 0.5,
      "bindings": [
        { "kind": "Direct", "path": "Keyboard/Space" },
        { "kind": "Direct", "path": "Gamepad/ButtonSouth" }
      ]
    },
    {
      "name": "Fire",
      "type": "Button",
      "userConfigurable": false,
      "activationThreshold": 0.5,
      "bindings": [
        { "kind": "Direct", "path": "Mouse/LeftButton" },
        { "kind": "Direct", "path": "Gamepad/RightTrigger" }
      ]
    }
  ]
}
