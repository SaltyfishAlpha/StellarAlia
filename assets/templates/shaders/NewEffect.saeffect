// @Effect  "NewEffect"
// @Stage   fragment
// @Inject  BeforeTonemap
// @In  hdr : sampled
// @Out hdr
#pragma sa_section fragment

#version 450

// set=2 binding=0 — EffectParams UBO (same convention as material MaterialParams).
// @Param values are inline member annotations, reflected by ShaderReflectTool.
layout(set = 2, binding = 0) uniform EffectParams {
    vec3  tint;      // @Color3("Tint") = 1,1,1
    float intensity; // @Range(0.0, 1.0, "Intensity") = 1.0
} u_Fx;

// set=2 binding=1..N — @In resources in declaration order (binding 0 = params).
layout(set = 2, binding = 1) uniform sampler2D t_hdr;

layout(location = 0) in  vec2 v_UV;
layout(location = 0) out vec4 out_Color;

void main() {
    vec3 c = texture(t_hdr, v_UV).rgb;
    out_Color = vec4(mix(c, c * u_Fx.tint, u_Fx.intensity), 1.0);
}

#pragma sa_end_section
